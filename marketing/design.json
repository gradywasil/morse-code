  "narrative": {
    "northStar": "The Register",
    "overview": "This campaign extends the app's punched-paper telegraph instrument. Warm dark ground supports cream text, amber keys and a moving paper register. Barlow explains the demonstration; mono carries the message, controls and measured status.\n\nThis file describes the campaign only. The app's design system remains authoritative for the instrument itself. The campaign adds larger stencil headings, a darker ground and a scrolling page with spacious sections.",
    "keyCharacteristics": [
      "Warm instrument ground and cream paper.",
      "Amber actions and signal states.",
      "Local stencil, Barlow and mono fonts.",
      "Punched tape moving beneath a fixed read head."
    ],
    "rules": [
      {
        "name": "The Warm Ground Rule",
        "body": "Keep supporting text and surface rules within the warm paper-and-ink family used by the campaign.",
        "section": "colors"
      },
      {
        "name": "The Measured Text Rule",
        "body": "Keep editable messages, counts, tape letters and receipt output in mono; use Barlow for explanatory copy.",
        "section": "typography"
      }
    ],
    "dos": [
      "**Do** use the campaign's final ground token and locally served fonts.",
      "**Do** keep the message, tape and receipt in the same mono voice.",
      "**Do** preserve the stacked mobile layout and the reduced-motion treatments."
    ],
    "donts": [
      "**Don't** transfer the campaign's large display scale into the compact app toolbar.",
      "**Don't** replace the paper register with a generic rounded card."
    ]
  }
