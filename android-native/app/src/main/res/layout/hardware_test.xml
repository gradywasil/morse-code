<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/hardware_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#171008" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/hardware_title" android:textColor="#E2D3A8" android:textSize="26sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/hardware_explanation" android:textColor="#E2D3A8" android:layout_marginTop="12dp" />
        <androidx.camera.view.PreviewView android:id="@+id/native_preview"
            android:layout_width="match_parent" android:layout_height="240dp"
            android:layout_marginTop="16dp" android:background="#000000" android:contentDescription="@string/preview_description" />
        <TextView android:id="@+id/hardware_status" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="#FFB454"
            android:layout_marginTop="12dp" android:accessibilityLiveRegion="polite" />
        <TextView android:id="@+id/hardware_details" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="#E2D3A8" android:layout_marginTop="12dp" />
        <Button android:id="@+id/preview_test" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/preview_start" />
        <Button android:id="@+id/flashlight_test" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/flashlight_on" />
        <Button android:id="@+id/stop_hardware" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/stop_hardware" />
        <Button android:id="@+id/app_settings" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/open_settings" />
        <Button android:id="@+id/close_hardware" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/return_to_morse" />
    </LinearLayout>
</ScrollView>
